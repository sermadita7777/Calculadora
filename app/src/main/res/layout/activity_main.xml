<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/calc_background"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical|end"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <ImageButton
            android:id="@+id/btnAbrirHistorial"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_history"
            android:src="@drawable/ic_history"
            app:tint="@color/calc_text_secondary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="bottom|end"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/tvHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:padding="8dp"
            android:alpha="0.7"
            android:textColor="@color/calc_text_history"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvExpression"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textColor="@color/calc_text_primary"
            android:textSize="44sp"
            android:fontFamily="sans-serif-light"
            android:textIsSelectable="false" />

        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textColor="@color/calc_text_secondary"
            android:textSize="26sp"
            android:fontFamily="sans-serif-light" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="24dp"
        android:background="@color/calc_divider" />

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="4"
        android:rowCount="5"
        android:padding="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnC"
            style="@style/CalcButton.Function"
            android:layout_height="68dp"
            android:layout_columnWeight="1"
            android:text="@string/btn_clear"
            android:textColor="@color/calc_accent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnParen"
            style="@style/CalcButton.Function"
            android:layout_height="68dp"
            android:layout_columnWeight="1"
            android:text="@string/btn_paren_pair" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPercent"
            style="@style/CalcButton.Function"
            android:layout_height="68dp"
            android:layout_columnWeight="1"
            android:text="@string/btn_percent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDiv"
            style="@style/CalcButton.Operator"
            android:layout_height="68dp"
            android:layout_columnWeight="1"
            android:text="@string/btn_div" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn7"
            style="@style/CalcButton.Digit"
            android:layout_height="68dp"
            android:layout_columnWeight="1"
            android:text="@string/btn_7" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn8"
            style="@style/CalcButton.Digit"
            android:layout_height="68dp"
            android:layout_columnWeight="1"
            android:text="@string/btn_8" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn9"
            style="@style/CalcButton.Digit"
            android:layout_height="68dp"
            android:layout_columnWeight="1"
            android:text="@string/btn_9" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMult"
            style="@style/CalcButton.Operator"
            android:layout_height="68dp"
            android:layout_columnWeight="1"
            android:text="@string/btn_mult" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn4"
            style="@style/CalcButton.Digit"
            android:layout_height="68dp"
            android:layout_columnWeight="1"
            android:text="@string/btn_4" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn5"
            style="@style/CalcButton.Digit"
            android:layout_height="68dp"
            android:layout_columnWeight="1"
            android:text="@string/btn_5" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn6"
            style="@style/CalcButton.Digit"
            android:layout_height="68dp"
            android:layout_columnWeight="1"
            android:text="@string/btn_6" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSub"
            style="@style/CalcButton.Operator"
            android:layout_height="68dp"
            android:layout_columnWeight="1"
            android:text="@string/btn_sub" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn1"
            style="@style/CalcButton.Digit"
            android:layout_height="68dp"
            android:layout_columnWeight="1"
            android:text="@string/btn_1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn2"
            style="@style/CalcButton.Digit"
            android:layout_height="68dp"
            android:layout_columnWeight="1"
            android:text="@string/btn_2" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn3"
            style="@style/CalcButton.Digit"
            android:layout_height="68dp"
            android:layout_columnWeight="1"
            android:text="@string/btn_3" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSum"
            style="@style/CalcButton.Operator"
            android:layout_height="68dp"
            android:layout_columnWeight="1"
            android:text="@string/btn_sum" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSign"
            style="@style/CalcButton.Function"
            android:layout_height="68dp"
            android:layout_columnWeight="1"
            android:text="@string/btn_sign"
            android:textSize="24sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn0"
            style="@style/CalcButton.Digit"
            android:layout_height="68dp"
            android:layout_columnWeight="1"
            android:text="@string/btn_0" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDot"
            style="@style/CalcButton.Digit"
            android:layout_height="68dp"
            android:layout_columnWeight="1"
            android:text="@string/btn_dot"
            android:textSize="32sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBackspace"
            style="@style/CalcButton.Function"
            android:layout_height="68dp"
            android:layout_columnWeight="1"
            android:contentDescription="@string/cd_backspace"
            app:icon="@drawable/ic_backspace"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="26dp"
            app:iconTint="@color/calc_accent" />

    </GridLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEqual"
        style="@style/CalcButton.Equal"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="14dp"
        android:layout_marginTop="4dp"
        android:text="@string/btn_equal" />

</LinearLayout>
